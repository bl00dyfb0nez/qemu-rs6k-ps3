# This is the build file for project "qemu"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER
 command = "cc" "-m64" $ARGS -MD -MQ $out -MF $DEPFILE -o $out "-c" $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

# Rules for linking.

rule STATIC_LINKER
 command = "ar" $LINK_ARGS $out $in
 description = Linking static target $out

rule STATIC_LINKER_RSP
 command = "ar" $LINK_ARGS $out @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $in
 description = Linking static target $out

rule c_LINKER
 command = "cc" "-m64" $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule c_LINKER_RSP
 command = "cc" "-m64" @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule CUSTOM_COMMAND_DEP
 command = $COMMAND
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = "C:/Users/Thewoodsman/qemu/build-ps3/pyvenv/bin/meson" "--internal" "regenerate" "C:/Users/Thewoodsman/qemu" "."
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 


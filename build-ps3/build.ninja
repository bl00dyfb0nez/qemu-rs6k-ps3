 ARGS = "-Ilibuser.a.p" "-I." "-I.." "-Iqapi" "-Itrace" "-Iui" "-Iui/shader" "-IC:/msys64/ucrt64/include/glib-2.0" "-IC:/msys64/ucrt64/lib/glib-2.0/include" "-fdiagnostics-color=auto" "-Wall" "-Winvalid-pch" "-std=gnu11" "-O2" "-g" "-mcx16" "-msse2" "-fno-link-libatomic" "-D_GNU_SOURCE" "-D_FILE_OFFSET_BITS=64" "-D_LARGEFILE_SOURCE" "-fno-strict-aliasing" "-fno-common" "-fwrapv" "-fno-pie" "-no-pie" "-ftrivial-auto-var-init=zero" "-fzero-init-padding-bits=all" "-fzero-call-used-regs=used-gpr" "-Wempty-body" "-Wendif-labels" "-Wexpansion-to-defined" "-Wformat-overflow=2" "-Wformat-security" "-Wformat-y2k" "-Wignored-qualifiers" "-Wimplicit-fallthrough=2" "-Winit-self" "-Wmissing-format-attribute" "-Wmissing-prototypes" "-Wnested-externs" "-Wold-style-declaration" "-Wold-style-definition" "-Wredundant-decls" "-Wshadow=local" "-Wstrict-prototypes" "-Wtype-limits" "-Wundef" "-Wvla" "-Wwrite-strings" "-Wno-missing-include-dirs" "-Wno-psabi" "-Wno-shift-negative-value" "-iquote" "." "-iquote" "C:/Users/Thewoodsman/qemu" "-iquote" "C:/Users/Thewoodsman/qemu/include" "-iquote" "C:/Users/Thewoodsman/qemu/host/include/x86_64" "-iquote" "C:/Users/Thewoodsman/qemu/host/include/generic" "-iquote" "C:/Users/Thewoodsman/qemu/tcg/x86_64" "-DCONFIG_USER_ONLY" "-DCOMPILING_SYSTEM_VS_USER"


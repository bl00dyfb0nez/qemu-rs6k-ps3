build gdbstub/gdbstub-xml.c: CUSTOM_COMMAND ../gdbstub/gdb-xml/power64-core.xml ../gdbstub/gdb-xml/power-fpu.xml ../gdbstub/gdb-xml/power-altivec.xml ../gdbstub/gdb-xml/power-spe.xml ../gdbstub/gdb-xml/power-vsx.xml | C$:/Users/Thewoodsman/qemu/gdbstub/../scripts/feature_to_c.py
 COMMAND = "C:/Users/Thewoodsman/qemu/build-ps3/pyvenv/bin/meson" "--internal" "exe" "--capture" "gdbstub/gdbstub-xml.c" "--" "C:/Users/Thewoodsman/qemu/build-ps3/pyvenv/bin/python.exe" "C:/Users/Thewoodsman/qemu/gdbstub/../scripts/feature_to_c.py" "../gdbstub/gdb-xml/power64-core.xml" "../gdbstub/gdb-xml/power-fpu.xml" "../gdbstub/gdb-xml/power-altivec.xml" "../gdbstub/gdb-xml/power-spe.xml" "../gdbstub/gdb-xml/power-vsx.xml"
 description = Generating$ gdbstub/gdbstub-xml.c$ with$ a$ custom$ command$ (wrapped$ by$ meson$ to$ capture$ output)

build target/hexagon/gen_semantics.exe.p/gen_semantics.c.obj: c_COMPILER ../target/hexagon/gen_semantics.c
 DEPFILE = "target/hexagon/gen_semantics.exe.p/gen_semantics.c.obj.d"
